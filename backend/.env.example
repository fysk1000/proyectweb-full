PORT=5050
NODE_ENV=development

# URL del frontend (para CORS)
FRONTEND_URL=http://localhost:3000

# URL pública del backend (cuando lo subas)
BACKEND_PUBLIC_URL=http://localhost:5050

# Seguridad
JWT_SECRET=pon_una_clave_muy_larga

# Mercado Pago
MP_ACCESS_TOKEN=APP_USR_xxx
# Webhook público (cuando lo subas): https://tu-backend/api/mp/webhook
MP_WEBHOOK_PATH=/api/mp/webhook

# Email (formulario Contacto)
# Dirección que recibe los mensajes del formulario "Contáctanos"
CONTACT_TO=alejandrofys01@gmail.com
# SMTP (ej. Gmail: smtp.gmail.com, puerto 587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# Usuario del correo desde el que se envía (ej. tu@gmail.com)
SMTP_USER=
# Contraseña de aplicación (App Password), no la contraseña de la cuenta. En Gmail: Cuenta > Seguridad > Contraseñas de aplicaciones.
SMTP_PASS=

# Uploads
MAX_UPLOAD_MB=5

# Groq (Asistente IA) - API key desde https://console.groq.com
GROQ_API_KEY=
# Modelo opcional (por defecto: llama-3.3-70b-versatile). Otros: llama-3.1-8b-instant, openai/gpt-oss-120b
# GROQ_MODEL=llama-3.3-70b-versatile
