PORT=5050
NODE_ENV=development

# URL del frontend (para CORS)
FRONTEND_URL=http://localhost:3000

# Render / producción: misma URL pública para callbacks Stripe y URLs de imágenes (subidas)
# FRONTEND_PUBLIC_URL=https://tu-servicio.onrender.com
# BACKEND_PUBLIC_URL=https://tu-servicio.onrender.com

# CORS: en Render o si el frontend está en otro dominio, permite cualquier origen
# CORS_ALLOW_ALL=true

# Opcional: ruta del HTML para ?stripe= (por defecto se infiere)
# STRIPE_RETURN_PATH=/frontend/index.html

# URL pública del backend (cuando lo subas)
BACKEND_PUBLIC_URL=http://localhost:5050

# Seguridad
JWT_SECRET=pon_una_clave_muy_larga
# Duración del token JWT (p. ej. 2h, 15m, 7d). Por defecto: 2h
# JWT_EXPIRES_IN=2h

# Mercado Pago
MP_ACCESS_TOKEN=APP_USR_xxx
# Webhook público (cuando lo subas): https://tu-backend/api/mp/webhook
MP_WEBHOOK_PATH=/api/mp/webhook

# Email (formulario Contacto)
# Dirección que recibe los mensajes del formulario "Contáctanos"
CONTACT_TO=alejandrofys01@gmail.com
# SMTP (ej. Gmail: smtp.gmail.com; en Render suele funcionar mejor 465 SSL)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Usuario del correo desde el que se envía (ej. tu@gmail.com)
SMTP_USER=
# Contraseña de aplicación (App Password), no la contraseña de la cuenta. En Gmail: Cuenta > Seguridad > Contraseñas de aplicaciones.
SMTP_PASS=

# Uploads
MAX_UPLOAD_MB=5

# Groq (Asistente IA) - API key desde https://console.groq.com
GROQ_API_KEY=
# Modelo opcional (por defecto: llama-3.3-70b-versatile). Otros: llama-3.1-8b-instant, openai/gpt-oss-120b
# GROQ_MODEL=llama-3.3-70b-versatile
